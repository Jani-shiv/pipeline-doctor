# Pipeline Doctor Environment Variables
# Copy this file to .env and fill in your values

# Application
PIPELINE_DOCTOR_DEBUG=false
PIPELINE_DOCTOR_LOG_LEVEL=INFO

# GitHub Actions
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# GitLab CI
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=12345678

# Jenkins
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=admin
JENKINS_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Azure DevOps
AZURE_PAT=xxxxxxxxxxxxxxxxxxxx
AZURE_ORG=your-org
AZURE_PROJECT=your-project

# CircleCI
CIRCLECI_TOKEN=xxxxxxxxxxxxxxxxxxxx
CIRCLECI_PROJECT=gh/your-org/your-repo

# Notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx
EMAIL_USER=alerts@example.com
EMAIL_PASSWORD=xxxxxxxx
PAGERDUTY_KEY=xxxxxxxxxxxxxxxxxxxx
WEBHOOK_URL=https://your-webhook.example.com

# Database (for PostgreSQL storage)
DB_PASSWORD=xxxxxxxx

# Storage
STORAGE_TYPE=sqlite
STORAGE_PATH=./data/pipeline-doctor.db